# ==============================================================================
# FashionScape Bot (fsbot) Environment Configuration
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# Docker Image (used by docker compose)
FSBOT_IMAGE=ghcr.io/fashionscape/discord-bot:latest

# Discord Configuration
FSBOT_DISCORD_TOKEN=your_discord_bot_token_here
FSBOT_OWNER_ID=123456789012345678
FSBOT_DEV_GUILD_ID=123456789012345678

# SeaweedFS (S3) Object Storage Configuration
# The bot talks to SeaweedFS's S3 gateway with the AWS SDK for Java v2.
SEAWEED_ENDPOINT=http://seaweed:8333
SEAWEED_ACCESS_KEY=seaweedadmin
SEAWEED_SECRET_KEY=seaweed_change_me_in_production
SEAWEED_BUCKET=fashionscape-outfits
# Must be https://${MEDIA_DOMAIN} so the links the bot posts resolve through Caddy.
SEAWEED_PUBLIC_URL=https://media.fashionscape.app

# Caddy reverse proxy (media domain)
# Public hostname for outfit images. Point its DNS at this host and open ports 80 and 443;
# Caddy then fetches and renews the HTTPS certificate on its own.
MEDIA_DOMAIN=media.fashionscape.app

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fashionscape
SPRING_DATASOURCE_USERNAME=fsbot
SPRING_DATASOURCE_PASSWORD=fsbot_change_me_in_production
POSTGRES_DB=fashionscape

# Application & Server Configuration
SERVER_PORT=8080
ENVIRONMENT=DEV

# Legacy Rehosting Trigger (Optional: set to 'true' or 'dry-run' to trigger CLI runner)
# FSBOT_REHOST_IMGUR=false
