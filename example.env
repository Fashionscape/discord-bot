# ==============================================================================
# FashionScape Bot (fsbot) Environment Configuration
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# Docker Image (used by docker compose)
FSBOT_IMAGE=ghcr.io/fashionscape/discord-bot:latest

# Discord Configuration
FSBOT_DISCORD_TOKEN=your_discord_bot_token_here
FSBOT_OWNER_ID=123456789012345678
FSBOT_DEV_GUILD_ID=123456789012345678

# MinIO (S3) Object Storage Configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fashionscape-outfits
MINIO_PUBLIC_URL=https://media.fashionscape.org

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fashionscape
SPRING_DATASOURCE_USERNAME=fsbot
SPRING_DATASOURCE_PASSWORD=fsbot_change_me_in_production
POSTGRES_DB=fashionscape

# Application & Server Configuration
SERVER_PORT=8080
ENVIRONMENT=DEV

# Legacy Rehosting Trigger (Optional: set to 'true' or 'dry-run' to trigger CLI runner)
# FSBOT_REHOST_IMGUR=false
